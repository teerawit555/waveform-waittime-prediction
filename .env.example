# Backend environment loaded from the project root.
# Copy this file to .env and replace the admin token before use.

# Access and runtime
NEUROSETTLE_ADMIN_TOKEN=
NEUROSETTLE_ENV=development
ENABLE_TRAINING=1
JOB_WORKERS=1

# Leave unset to let the backend resolve the newest ready model.
# DEFAULT_MODEL_NAME=wave_model_v3

# Flask server
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=0

# Browser access and uploads
NEUROSETTLE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
MAX_UPLOAD_MB=2048

# Per-client in-memory rate limits
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_UPLOAD=20
RATE_LIMIT_PREDICT=30
RATE_LIMIT_TRAIN=5

# MLflow
# MLFLOW_TRACKING_URI=file:///C:/path/to/project/mlruns
MLFLOW_EXPERIMENT_NAME=adaptive-wait-time
MLFLOW_LOG_MODEL_DIRS=0
MLFLOW_REGISTERED_MODEL_NAME=adaptive_wait_time_hybrid
MLFLOW_DISABLED=0

# Training defaults
DEFAULT_TCN_AUGMENT=0
DEFAULT_TCN_EPOCHS=30
DEFAULT_TCN_NOISE_STD=0.015
DEFAULT_TCN_SCALE_JITTER=0.04
DEFAULT_TCN_TIME_SHIFT=8
DEFAULT_TCN_FAST_WEIGHT=1.0
DEFAULT_TCN_EARLY_STOPPING_PATIENCE=5
DEFAULT_AG_PRESETS=medium_quality
DEFAULT_AG_TIME_LIMIT=300
